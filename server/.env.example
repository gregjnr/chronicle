# Server Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (e.g. MongoDB Atlas or local mongod)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/blog-platform?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/blog-platform
MONGODB_URI=mongodb://localhost:27017/blog-platform

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
